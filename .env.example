# Clerk (authentication) - staff login only.
# Get these from https://dashboard.clerk.com -> your app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (database). Server-side only. Never expose the service role key.
# Get these from https://supabase.com/dashboard -> your project ->
# Settings -> API (Project URL and service_role key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk route paths (optional, recommended).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin
